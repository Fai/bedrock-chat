# E2E Test Environment Configuration

# Frontend URL (default: http://localhost:5173 for dev, http://localhost:4173 for preview)
BASE_URL=http://localhost:5173

# Test user credentials (for environments with test users)
TEST_EMAIL=test@example.com
TEST_PASSWORD=TestPassword123!

# AWS Configuration (if testing against real backend)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# Backend API URL (if testing against deployed backend)
API_URL=https://your-api-gateway-url.execute-api.us-east-1.amazonaws.com

# Test data configuration
TEST_WORKGROUP_NAME=test-workgroup
TEST_DATABASE_NAME=test_db
TEST_TABLE_NAME=products

# Timeouts (in milliseconds)
DEFAULT_TIMEOUT=30000
LONG_TIMEOUT=60000
